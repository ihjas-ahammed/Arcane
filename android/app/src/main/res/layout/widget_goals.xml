<?xml version="1.0" encoding="utf-8"?>
<!-- Tactical Goals Directives widget — dual-theme compliant, amber HUD styling -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_goals_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/widget_goals_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_bg_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_bg_art_amber"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Header Row: Scope Tag + XP Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/widget_accent_amber" />

                <TextView
                    android:id="@+id/widget_goals_status_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="[ DIRECTIVES // STANDBY ]"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_goals_xp_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_minicard_bg_amber"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="0 / 0 DONE"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Progress Bar Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/widget_goals_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress_amber" />

                <TextView
                    android:id="@+id/widget_goals_progress_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="0%"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Content Area: Goals Slots OR Empty Standby -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <!-- Goals List Container -->
                <LinearLayout
                    android:id="@+id/widget_goals_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <!-- Slot 0 -->
                    <LinearLayout
                        android:id="@+id/widget_goal_0_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/widget_goal_0_check"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/widget_check_off_amber"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/widget_bg_deep"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_goal_0_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text="DIRECTIVE 01"
                            android:textColor="@color/widget_text_white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/widget_goal_0_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/widget_text_muted"
                            android:textSize="8.5sp" />
                    </LinearLayout>

                    <!-- Slot 1 -->
                    <LinearLayout
                        android:id="@+id/widget_goal_1_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/widget_goal_1_check"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/widget_check_off_amber"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/widget_bg_deep"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_goal_1_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text="DIRECTIVE 02"
                            android:textColor="@color/widget_text_white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/widget_goal_1_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/widget_text_muted"
                            android:textSize="8.5sp" />
                    </LinearLayout>

                    <!-- Slot 2 -->
                    <LinearLayout
                        android:id="@+id/widget_goal_2_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/widget_goal_2_check"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/widget_check_off_amber"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/widget_bg_deep"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_goal_2_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text="DIRECTIVE 03"
                            android:textColor="@color/widget_text_white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/widget_goal_2_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/widget_text_muted"
                            android:textSize="8.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Empty Standby Container -->
                <LinearLayout
                    android:id="@+id/widget_goals_empty_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/widget_goals_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="NO DIRECTIVES LOGGED FOR TODAY"
                        android:textColor="@color/widget_text_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_goals_empty_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="INITIALIZE IN ARCANE GOALS SUITE"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="8.5sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
