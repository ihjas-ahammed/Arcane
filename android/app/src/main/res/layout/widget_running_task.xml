<?xml version="1.0" encoding="utf-8"?>
<!-- Fully native Task Hero / Active Mission widget — crisp text, tactical HUD styling, rounded borders -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_running_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/widget_running_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_bg_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_bg_art_cyan"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_status_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="[ MISSION // STANDBY ]"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_rec_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:text="● REC"
                    android:textColor="@color/widget_accent_red"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_capacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp" />

                <TextView
                    android:id="@+id/widget_btn_dayplan"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:background="@drawable/widget_btn_dayplan"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="DAY PLAN"
                    android:textColor="@color/widget_text_mid"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtitle / Parent Task / Route Context -->
            <LinearLayout
                android:id="@+id/widget_subtitle_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_task_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="QUEUE STANDBY"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Main Task Title (prominent hero headline, weight=1, vertically centered) -->
            <TextView
                android:id="@+id/widget_task_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:fontFamily="monospace"
                android:text="NO PLAN SET"
                android:textColor="@color/widget_text_white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Telemetry / Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_mode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="TODAY:"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Chronometer
                    android:id="@+id/widget_task_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_task_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="monospace"
                    android:text="00:00"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_task_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_amber" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:id="@+id/widget_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_btn_engage"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/widget_btn_primary_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="ENGAGE"
                    android:textColor="@color/widget_bg_deep"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_btn_check"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:background="@drawable/widget_btn_outline_cyan"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="CHECK"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_btn_finish"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:background="@drawable/widget_btn_outline_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="FINISH"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
