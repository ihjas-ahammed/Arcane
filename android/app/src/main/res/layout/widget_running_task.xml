<?xml version="1.0" encoding="utf-8"?>
<!-- Fully native (RemoteViews) running-task widget with Tactical HUD styling matching Schedule Hero. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/widget_root_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_bg_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_bg_art_cyan"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/widget_card_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

        <!-- ===== Multitask layout (2-in-1 / 3-in-1) ===== -->
        <LinearLayout
            android:id="@+id/widget_multitask_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Status bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_mt_status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_pip_on" />

                <TextView
                    android:id="@+id/widget_mt_status_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="MULTITASK PROTOCOL · [02 ACTIVE]"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_mt_rec_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:text="REC"
                    android:textColor="@color/widget_accent_red"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/widget_mt_btn_dayplan"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/widget_btn_dayplan"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"
                        android:text="DAY PLAN"
                        android:textColor="@color/widget_text_mid"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mini cards container -->
            <LinearLayout
                android:id="@+id/widget_mt_cards_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- Card 0 -->
                <LinearLayout
                    android:id="@+id/widget_mt_card_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_minicard_bg_cyan"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/widget_mt_parent_0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text=""
                            android:textColor="@color/widget_accent_cyan"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="01"
                            android:textColor="@color/widget_text_muted"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_mt_title_0"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text=""
                        android:textColor="@color/widget_text_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_mt_cps_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="✓ 0/0"
                        android:textColor="@color/widget_accent_cyan"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Card 1 -->
                <LinearLayout
                    android:id="@+id/widget_mt_card_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_minicard_bg_cyan"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/widget_mt_parent_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text=""
                            android:textColor="@color/widget_accent_cyan"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="02"
                            android:textColor="@color/widget_text_muted"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_mt_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text=""
                        android:textColor="@color/widget_text_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_mt_cps_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="✓ 0/0"
                        android:textColor="@color/widget_accent_cyan"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Card 2 -->
                <LinearLayout
                    android:id="@+id/widget_mt_card_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_minicard_bg_cyan"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/widget_mt_parent_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text=""
                            android:textColor="@color/widget_accent_cyan"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="03"
                            android:textColor="@color/widget_text_muted"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_mt_title_2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text=""
                        android:textColor="@color/widget_text_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_mt_cps_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="✓ 0/0"
                        android:textColor="@color/widget_accent_cyan"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Multitask Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_mt_btn_engage"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_primary_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="ENGAGE ALL"
                    android:textColor="@color/widget_bg_deep"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_mt_btn_check"
                    android:layout_width="72dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_outline_cyan"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="CHECK"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_mt_btn_finish"
                    android:layout_width="72dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_outline_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="FINISH"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Running / standby layout ===== -->
        <LinearLayout
            android:id="@+id/widget_running_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_pip_on" />

                <TextView
                    android:id="@+id/widget_status_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="ACTIVE · STANDBY"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_rec_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:text="REC"
                    android:textColor="@color/widget_accent_red"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/widget_btn_dayplan"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/widget_btn_dayplan"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"
                        android:text="DAY PLAN"
                        android:textColor="@color/widget_text_mid"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Title & Subtitle container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_task_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="NO PLAN SET"
                    android:textColor="@color/widget_text_white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:id="@+id/widget_subtitle_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/widget_subtitle_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp">

                    <TextView
                        android:id="@+id/widget_task_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="QUEUE STANDBY"
                        android:textColor="@color/widget_text_mid"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Time & Capacity row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_capacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text=""
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_mode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:text="TODAY"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <Chronometer
                    android:id="@+id/widget_task_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_task_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00:00"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/widget_task_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_amber" />

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_btn_engage"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_primary_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="ENGAGE"
                    android:textColor="@color/widget_bg_deep"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_btn_check"
                    android:layout_width="72dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_outline_cyan"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="CHECK"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_btn_finish"
                    android:layout_width="72dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_outline_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="FINISH"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

