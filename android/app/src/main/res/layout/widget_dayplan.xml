<?xml version="1.0" encoding="utf-8"?>
<!-- Fully native Day Plan checklist widget — crisp text, rounded borders, background art -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dayplan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/widget_dayplan_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_bg_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_bg_art_cyan"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_dayplan_status_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:text="[ DAY PLAN // DISPATCH ]"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_dayplan_capacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Checklist Rows Container -->
            <LinearLayout
                android:id="@+id/widget_dayplan_list_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Row 0 -->
                <LinearLayout
                    android:id="@+id/widget_dayplan_row_0"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/widget_accent_cyan" />

                    <TextView
                        android:id="@+id/widget_dayplan_row_title_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/widget_text_white"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_dayplan_btn_check_0"
                        android:layout_width="34dp"
                        android:layout_height="22dp"
                        android:background="@drawable/widget_btn_outline_cyan"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/widget_accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 1 -->
                <LinearLayout
                    android:id="@+id/widget_dayplan_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/widget_accent_cyan" />

                    <TextView
                        android:id="@+id/widget_dayplan_row_title_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/widget_text_white"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_dayplan_btn_check_1"
                        android:layout_width="34dp"
                        android:layout_height="22dp"
                        android:background="@drawable/widget_btn_outline_cyan"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/widget_accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:id="@+id/widget_dayplan_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/widget_accent_cyan" />

                    <TextView
                        android:id="@+id/widget_dayplan_row_title_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/widget_text_white"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_dayplan_btn_check_2"
                        android:layout_width="34dp"
                        android:layout_height="22dp"
                        android:background="@drawable/widget_btn_outline_cyan"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/widget_accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:id="@+id/widget_dayplan_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/widget_accent_cyan" />

                    <TextView
                        android:id="@+id/widget_dayplan_row_title_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/widget_text_white"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_dayplan_btn_check_3"
                        android:layout_width="34dp"
                        android:layout_height="22dp"
                        android:background="@drawable/widget_btn_outline_cyan"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/widget_accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:id="@+id/widget_dayplan_row_4"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/widget_accent_cyan" />

                    <TextView
                        android:id="@+id/widget_dayplan_row_title_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/widget_text_white"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_dayplan_btn_check_4"
                        android:layout_width="34dp"
                        android:layout_height="22dp"
                        android:background="@drawable/widget_btn_outline_cyan"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/widget_accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Empty state -->
                <TextView
                    android:id="@+id/widget_dayplan_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="NO ACTIVE PLAN · QUEUE STANDBY"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_dayplan_btn_open"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_primary_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="OPEN PLAN"
                    android:textColor="@color/widget_bg_deep"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_dayplan_btn_task"
                    android:layout_width="100dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/widget_btn_outline_cyan"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="ACTIVE TASK"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
