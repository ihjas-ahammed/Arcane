<?xml version="1.0" encoding="utf-8"?>
<!-- Fully native Day Plan dispatch widget — crisp text, tactical HUD styling, rounded borders -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dayplan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/widget_dayplan_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_bg_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_bg_art_cyan"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_dayplan_status_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="[ DAY PLAN // DISPATCH ]"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_dayplan_capacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Primary Planned Mission (Hero Title) -->
            <TextView
                android:id="@+id/widget_dayplan_primary_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:fontFamily="monospace"
                android:text="NO MISSIONS PLANNED"
                android:textColor="@color/widget_text_white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Telemetry / Next Mission Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_dayplan_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="NEXT:"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_dayplan_next_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="monospace"
                    android:text="QUEUE STANDBY"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_dayplan_items_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_dayplan_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_cyan" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:id="@+id/widget_dayplan_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_dayplan_btn_open"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/widget_btn_primary_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="OPEN PLAN"
                    android:textColor="@color/widget_bg_deep"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_dayplan_btn_check"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:background="@drawable/widget_btn_outline_cyan"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="CHECK"
                    android:textColor="@color/widget_accent_cyan"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_dayplan_btn_task"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:background="@drawable/widget_btn_outline_amber"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="ENGAGE"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
